@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@implements IDisposable

<header class="navbar">
    <div class="navbar-inner container">
        <a class="navbar-logo" href="./">Quest<span class="navbar-logo-accent">log</span></a>

        <div class="navbar-search">
            <span class="navbar-search-icon" aria-hidden="true">⌕</span>
            <input class="navbar-search-input" placeholder="Search games..." aria-label="Search games" @bind="query" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            @if (hasActiveSearch)
            {
                <button type="button" class="navbar-search-clear" aria-label="Clear search" @onclick="ClearSearch">
                    <span aria-hidden="true">✕</span>
                </button>
            }
            <button type="button" class="navbar-search-button" aria-label="Search" @onclick="Search">
                <span aria-hidden="true">⌕</span>
            </button>
        </div>

        <nav class="navbar-links">
            <NavLink class="navbar-link" href="" Match="NavLinkMatch.All">Explore</NavLink>
            <NavLink class="navbar-link" href="my-shelf">My Shelf</NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="navbar-avatar" href="Account/Manage" title="@context.User.Identity?.Name" aria-label="Account">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <path fill="currentColor" d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5Zm0 2.5c-3.33 0-10 1.67-10 5V22h20v-2.5c0-3.33-6.67-5-10-5Z" />
                        </svg>
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="navbar-link navbar-link-muted" href="Account/Login">Log in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private string query = string.Empty;
    private bool hasActiveSearch;

    protected override void OnInitialized()
    {
        SyncFromUri(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncFromUri(e.Location);
        StateHasChanged();
    }

    private void SyncFromUri(string uri)
    {
        var queryFromUri = QueryHelpers.ParseQuery(new Uri(uri).Query).TryGetValue("q", out var q) ? q.ToString() : "";
        query = queryFromUri;
        hasActiveSearch = !string.IsNullOrEmpty(queryFromUri);
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Search();
        }
    }

    private void Search()
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            Nav.NavigateTo($"/?q={Uri.EscapeDataString(query)}");
        }
    }

    private void ClearSearch()
    {
        query = string.Empty;
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
