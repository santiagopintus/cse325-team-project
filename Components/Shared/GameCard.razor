<div class="game-card" data-tilt="@(EnableTilt ? "true" : null)">
    <div class="game-card-image" style="@(!string.IsNullOrWhiteSpace(ImageUrl) ? $"background-image: url('{ImageUrl}')" : null)" role="img" aria-label="@($"{Title} cover art")">
        @if (!string.IsNullOrWhiteSpace(Tag))
        {
            <div class="game-card-tag">@Tag</div>
        }
        @if (!string.IsNullOrWhiteSpace(Score))
        {
            <div class="game-card-badge">
                <span class="game-card-star" aria-hidden="true">★</span>
                <span>@Score</span>
            </div>
        }
    </div>

    <div class="game-card-content">
        <div class="game-card-info">
            <h4 class="game-card-title">@Title</h4>
            @if (!string.IsNullOrWhiteSpace(Platform))
            {
                <p class="game-card-platform">@Platform</p>
            }
        </div>
        @if (ChildContent is not null)
        {
            <div class="game-card-actions">
                @ChildContent
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public string? Platform { get; set; }

    [Parameter]
    public string? Score { get; set; }

    [Parameter]
    public string? Tag { get; set; }

    [Parameter]
    public bool EnableTilt { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
