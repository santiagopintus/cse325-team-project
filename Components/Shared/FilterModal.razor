@using QuestLog.Services.Rawg

@if (IsOpen)
{
    <div class="filter-overlay" @onclick="Close">
        <div class="filter-panel" @onclick:stopPropagation="true">
            <div class="filter-header">
                <h4>Filters</h4>
                <button type="button" class="filter-close" @onclick="Close" aria-label="Close">&#10005;</button>
            </div>

            <div class="filter-body">
                <div class="filter-section">
                    <div class="filter-section-header">
                        <label for="filter-metacritic" class="form-label">Minimum Metacritic Score</label>
                        @if (!string.IsNullOrEmpty(localMinMetacritic))
                        {
                            <button type="button" class="filter-section-clear" @onclick="() => localMinMetacritic = string.Empty" aria-label="Clear metacritic filter">&#10005;</button>
                        }
                    </div>
                    <select id="filter-metacritic" class="form-select form-select-sm" @bind="localMinMetacritic">
                        <option value="">Any</option>
                        <option value="50">50+</option>
                        <option value="70">70+</option>
                        <option value="80">80+</option>
                        <option value="90">90+</option>
                    </select>
                </div>

                <div class="filter-section">
                    <div class="filter-section-header">
                        <span class="form-label">Genres</span>
                        @if (localGenreIds.Count > 0)
                        {
                            <button type="button" class="filter-section-clear" @onclick="() => localGenreIds.Clear()" aria-label="Clear genre filter">&#10005;</button>
                        }
                    </div>
                    <div class="filter-checklist">
                        @foreach (var genre in AllGenres)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="genre-@genre.Id"
                                       checked="@localGenreIds.Contains(genre.Id)"
                                       @onchange="e => ToggleId(localGenreIds, genre.Id, e)" />
                                <label class="form-check-label" for="genre-@genre.Id">@genre.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-section-header">
                        <span class="form-label">Platforms</span>
                        @if (localPlatformIds.Count > 0)
                        {
                            <button type="button" class="filter-section-clear" @onclick="() => localPlatformIds.Clear()" aria-label="Clear platform filter">&#10005;</button>
                        }
                    </div>
                    <div class="filter-checklist">
                        @foreach (var platform in AllPlatforms)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="platform-@platform.Id"
                                       checked="@localPlatformIds.Contains(platform.Id)"
                                       @onchange="e => ToggleId(localPlatformIds, platform.Id, e)" />
                                <label class="form-check-label" for="platform-@platform.Id">@platform.Name</label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="filter-footer">
                <button class="btn btn-outline-secondary btn-sm" @onclick="Close">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="Apply">Apply</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public List<int> SelectedGenreIds { get; set; } = new();

    [Parameter]
    public List<int> SelectedPlatformIds { get; set; } = new();

    [Parameter]
    public int? MinMetacritic { get; set; }

    [Parameter]
    public EventCallback<(List<int> GenreIds, List<int> PlatformIds, int? MinMetacritic)> OnApply { get; set; }

    [Parameter]
    public List<RawgGenreDto> AllGenres { get; set; } = new();

    [Parameter]
    public List<RawgPlatformDto> AllPlatforms { get; set; } = new();

    private bool hasLoadedOptions;

    private List<int> localGenreIds = new();
    private List<int> localPlatformIds = new();
    private string localMinMetacritic = "";

    protected override void OnParametersSet()
    {
        if (IsOpen && !hasLoadedOptions)
        {
            hasLoadedOptions = true;

            localGenreIds = new List<int>(SelectedGenreIds);
            localPlatformIds = new List<int>(SelectedPlatformIds);
            localMinMetacritic = MinMetacritic?.ToString() ?? "";
        }
        else if (!IsOpen)
        {
            hasLoadedOptions = false;
        }
    }

    private static void ToggleId(List<int> ids, int id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked && !ids.Contains(id))
        {
            ids.Add(id);
        }
        else if (!isChecked)
        {
            ids.Remove(id);
        }
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Apply()
    {
        int? minMetacritic = int.TryParse(localMinMetacritic, out var parsed) ? parsed : null;
        await OnApply.InvokeAsync((localGenreIds, localPlatformIds, minMetacritic));
        await IsOpenChanged.InvokeAsync(false);
    }
}
