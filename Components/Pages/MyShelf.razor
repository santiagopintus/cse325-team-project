@page "/my-shelf"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using QuestLog.Data
@using QuestLog.Models
@using QuestLog.Services.Rawg
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toast
@inject ExploreGamesCache ExploreCache
@inject RawgApiService RawgApi
@inject IJSRuntime JS

<PageTitle>My Shelf</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Shelf</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm" @onclick="() => showAddModal = true">+ Add a Game</button>
        <button class="btn btn-sm @(isEditMode ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleEditMode">
            @(isEditMode ? "Done Editing" : "Edit Games")
        </button>
    </div>
</div>

<div class="btn-group mb-4" role="group" aria-label="Filter by status">
    <button class="btn btn-sm @(statusFilter is null ? "btn-primary" : "btn-outline-primary")" @onclick="() => Filter(null)">All</button>
    @foreach (var status in Enum.GetValues<PlayStatus>())
    {
        <button class="btn btn-sm @(statusFilter == status ? "btn-primary" : "btn-outline-primary")" @onclick="() => Filter(status)">@status</button>
    }
</div>

@if (isLoading)
{
    <p>Loading your shelf...</p>
}
else if (filteredGames.Count == 0)
{
    <p>No games on your shelf yet@(statusFilter is null ? "" : $" with status \"{statusFilter}\"").</p>
}
else
{
    <div class="game-grid">
        @foreach (var game in filteredGames)
        {
            <div id="game-@game.RawgId" class="game-card-anchor">
                <GameCard Title="@game.Title"
                          ImageUrl="@game.CoverArtUrl"
                          Platform="@game.Platform"
                          Score="@(game.UserRating > 0 ? $"{game.UserRating}/5" : null)"
                          Tag="@(IsManuallyAdded(game) ? "Manually Added" : null)"
                          CssClass="game-card-shelf"
                          EditMode="isEditMode"
                          IdPrefix="@game.Id.ToString()"
                          TitleChanged="t => UpdateTitle(game, t)"
                          PlatformOptions="platformOptions"
                          SelectedPlatforms="@ParsePlatforms(game.Platform)"
                          SelectedPlatformsChanged="p => UpdatePlatforms(game, p)">
                    <UserGameStatusFields IdPrefix="@game.Id.ToString()"
                                          Status="game.Status" StatusChanged="s => UpdateStatus(game, s)"
                                          Rating="game.UserRating" RatingChanged="r => UpdateRating(game, r)"
                                          Notes="@game.Notes" NotesChanged="n => UpdateNotes(game, n)"
                                          EditMode="isEditMode" />

                    @if (IsManuallyAdded(game))
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteWithConfirmation(game)">Delete</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(game)">Remove from my shelf</button>
                    }
                </GameCard>
            </div>
        }
    </div>
}

<AddGameModal IsOpen="showAddModal" IsOpenChanged="v => showAddModal = v" OnGameAdded="ReloadGames" />

@code {
    private List<UserGame> games = new();
    private List<UserGame> filteredGames = new();
    private PlayStatus? statusFilter;
    private bool isLoading = true;
    private string? userId;
    private bool showAddModal = false;
    private bool isEditMode = false;
    private List<RawgPlatformDto> platformOptions = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        platformOptions = await RawgApi.GetPlatformsAsync();
        await LoadGames();
        isLoading = false;
    }

    private static bool IsManuallyAdded(UserGame game) => game.RawgId <= 0;

    private static List<string> ParsePlatforms(string platform) =>
        platform
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }

    private async Task UpdateTitle(UserGame game, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        game.Title = value.Trim();
        await SaveChange(game);
    }

    private async Task UpdatePlatforms(UserGame game, List<string> platforms)
    {
        game.Platform = string.Join(", ", platforms);
        await SaveChange(game);
    }

    private async Task LoadGames()
    {
        if (userId != null)
        {
            games = await DbContext.UserGames
                .Where(g => g.UserId == userId)
                .OrderByDescending(g => g.DateAdded)
                .ToListAsync();
        }

        ApplyFilter();
    }

    private async Task ReloadGames() => await LoadGames();

    private void Filter(PlayStatus? status)
    {
        statusFilter = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredGames = statusFilter is null
            ? games
            : games.Where(g => g.Status == statusFilter).ToList();
    }

    private async Task UpdateStatus(UserGame game, PlayStatus value)
    {
        game.Status = value;
        await SaveChange(game);
    }

    private async Task UpdateRating(UserGame game, int value)
    {
        game.UserRating = value;
        await SaveChange(game);
    }

    private async Task UpdateNotes(UserGame game, string value)
    {
        game.Notes = value;
        await SaveChange(game);
    }

    private async Task SaveChange(UserGame game)
    {
        game.DateUpdated = DateTime.UtcNow;
        try
        {
            await DbContext.SaveChangesAsync();
        }
        catch (Exception)
        {
            Toast.Show("Couldn't save your changes. Please try again.", ToastLevel.Error);
        }
    }

    private async Task DeleteWithConfirmation(UserGame game)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{game.Title}\"? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await Delete(game);
    }

    private async Task Delete(UserGame game)
    {
        try
        {
            DbContext.UserGames.Remove(game);
            await DbContext.SaveChangesAsync();
            games.Remove(game);
            ApplyFilter();
            ExploreCache.AddedRawgIds.Remove(game.RawgId);
        }
        catch (Exception)
        {
            Toast.Show("Couldn't remove that game. Please try again.", ToastLevel.Error);
        }
    }
}
