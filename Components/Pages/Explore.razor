@page "/"
@using Microsoft.EntityFrameworkCore
@using QuestLog.Data
@using QuestLog.Models
@using QuestLog.Services.Rawg
@inject RawgApiService RawgApi
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@inject ExploreGamesCache Cache

<PageTitle>Explore Games</PageTitle>

<h1>Explore Games</h1>

@if (isFallbackActive && !searchFailed)
{
    <div class="explore-fallback-banner">
        Showing offline demo data &mdash; RAWG is temporarily unreachable. Filters and "Add to Shelf" still work.
    </div>
}

@if (!searchFailed)
{
    <div class="explore-toolbar">
        @if (isShowingPreferredPlatforms)
        {
            <span class="explore-toolbar-legend">
                Showing games for your preferred platforms
                <button type="button" class="explore-toolbar-legend-link" @onclick="ClearPlatformFilter">Show all instead</button>
            </span>
        }
        else
        {
            <span></span>
        }

        <button class="btn btn-outline-secondary btn-sm" @onclick="() => showFilterModal = true">
            Filters@(activeFilterCount > 0 ? $" ({activeFilterCount})" : "")
        </button>
    </div>

    @if (selectedGenreIds.Count > 0 || (selectedPlatformIds.Count > 0 && !isShowingPreferredPlatforms) || minMetacritic.HasValue)
    {
        <div class="explore-filter-pills">
            @if (selectedGenreIds.Count > 0)
            {
                <span class="filter-pill">
                    Genre: @GenreNames(selectedGenreIds)
                    <button type="button" class="filter-pill-clear" @onclick="ClearGenreFilter" aria-label="Clear genre filter">&#10005;</button>
                </span>
            }
            @if (selectedPlatformIds.Count > 0 && !isShowingPreferredPlatforms)
            {
                <span class="filter-pill">
                    Platforms: @PlatformNames(selectedPlatformIds)
                    <button type="button" class="filter-pill-clear" @onclick="ClearPlatformFilter" aria-label="Clear platform filter">&#10005;</button>
                </span>
            }
            @if (minMetacritic.HasValue)
            {
                <span class="filter-pill">
                    Metacritic: @(minMetacritic)+
                    <button type="button" class="filter-pill-clear" @onclick="ClearMetacriticFilter" aria-label="Clear metacritic filter">&#10005;</button>
                </span>
            }
        </div>
    }

    <FilterModal IsOpen="showFilterModal"
                 IsOpenChanged="v => showFilterModal = v"
                 SelectedGenreIds="selectedGenreIds"
                 SelectedPlatformIds="selectedPlatformIds"
                 MinMetacritic="minMetacritic"
                 OnApply="ApplyFilters"
                 AllGenres="allGenres"
                 AllPlatforms="allPlatforms" />
}

@if (searchFailed)
{
    <div class="explore-error">
        <p class="explore-error-title">@lastErrorMessage</p>
        <div class="explore-error-actions">
            <button class="btn btn-primary" @onclick="RetryLoad">Retry</button>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/my-shelf")'>Go to My Shelf</button>
        </div>
    </div>
}
else if (isSearching)
{
    <p>Searching...</p>
}
else if (games.Count > 0)
{
    <div class="game-grid">
        @foreach (var game in games)
        {
            <GameCard Title="@game.Name"
                      ImageUrl="@game.Background_Image"
                      Platform="@string.Join(", ", game.Platforms.Select(p => p.Platform.Name))"
                      Score="@game.Metacritic?.ToString()"
                      EnableTilt="true">
                <AuthorizeView>
                    <Authorized>
                        @if (addedRawgIds.Contains(game.Id))
                        {
                            <button class="btn btn-sm btn-view-shelf" @onclick='() => Nav.NavigateTo($"/my-shelf#game-{game.Id}")'>View in My Shelf</button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="(MouseEventArgs e) => AddToShelf(game, e)">Add to Shelf</button>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a href="Account/Login" class="btn btn-outline-secondary btn-sm">Log in to Add</a>
                    </NotAuthorized>
                </AuthorizeView>
            </GameCard>
        }
    </div>

    @if (hasMore)
    {
        <div class="see-more-wrapper">
            <button class="btn btn-see-more" disabled="@isLoadingMore" @onclick="LoadMoreGames">
                @(isLoadingMore ? "Loading..." : "See more") <span aria-hidden="true">&darr;</span>
            </button>
        </div>
    }
}
else if (hasSearched)
{
    <p>@(string.IsNullOrWhiteSpace(searchQuery) ? "No games found." : $"No games found for \"{searchQuery}\".")</p>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    [SupplyParameterFromQuery(Name = "genres")]
    public string? GenresParam { get; set; }

    [SupplyParameterFromQuery(Name = "platforms")]
    public string? PlatformsParam { get; set; }

    [SupplyParameterFromQuery(Name = "metacritic")]
    public int? MetacriticParam { get; set; }

    private string searchQuery = "";
    private string? lastQuery;
    private string? lastFilterSignature;
    private List<RawgGameDto> games = new();
    private HashSet<int> addedRawgIds = new();
    private bool isSearching;
    private bool hasSearched;
    private bool searchFailed;
    private string? lastErrorMessage;
    private bool isFallbackActive;
    private string? userId;
    private int currentPage = 1;
    private bool hasMore;
    private bool isLoadingMore;
    private bool showFilterModal;
    private List<int> selectedGenreIds = new();
    private List<int> selectedPlatformIds = new();
    private int? minMetacritic;
    private List<RawgGenreDto> allGenres = new();
    private List<RawgPlatformDto> allPlatforms = new();

    private int activeFilterCount =>
        selectedGenreIds.Count + selectedPlatformIds.Count + (minMetacritic.HasValue ? 1 : 0);

    private bool isShowingPreferredPlatforms =>
        preferredPlatformIds.Count > 0 &&
        selectedPlatformIds.Count == preferredPlatformIds.Count &&
        !selectedPlatformIds.Except(preferredPlatformIds).Any();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        var genresTask = RawgApi.GetGenresAsync();
        var platformsTask = RawgApi.GetPlatformsAsync();
        await Task.WhenAll(LoadPreferredPlatformIdsAsync(), genresTask, platformsTask);
        allGenres = genresTask.Result;
        allPlatforms = platformsTask.Result;
        isFallbackActive = RawgApi.LastFetchWasFallback;

        ParseFilterParams();

        if (string.IsNullOrWhiteSpace(QueryParam))
        {
            var filterSignature = BuildFilterSignature();

            if (Cache.IsPopulated && Cache.Query == null && Cache.FilterSignature == filterSignature)
            {
                currentFetcher = BuildPopularFetcher();
                RestoreFromCache();
            }
            else
            {
                await LoadDefaultGames();
            }

            lastFilterSignature = filterSignature;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("questLogTilt.init");
    }

    protected override async Task OnParametersSetAsync()
    {
        ParseFilterParams();
        var filterSignature = BuildFilterSignature();

        if (!string.IsNullOrWhiteSpace(QueryParam))
        {
            if (QueryParam != lastQuery || filterSignature != lastFilterSignature)
            {
                lastQuery = QueryParam;
                lastFilterSignature = filterSignature;
                searchQuery = QueryParam;

                if (Cache.IsPopulated && Cache.Query == QueryParam && Cache.FilterSignature == filterSignature)
                {
                    currentFetcher = BuildSearchFetcher();
                    RestoreFromCache();
                }
                else
                {
                    await Search();
                }
            }
        }
        else if (filterSignature != lastFilterSignature)
        {
            lastQuery = null;
            lastFilterSignature = filterSignature;

            if (Cache.IsPopulated && Cache.Query == null && Cache.FilterSignature == filterSignature)
            {
                currentFetcher = BuildPopularFetcher();
                RestoreFromCache();
            }
            else
            {
                await LoadDefaultGames();
            }
        }
    }

    private List<int> preferredPlatformIds = new();

    private async Task LoadPreferredPlatformIdsAsync()
    {
        if (userId is null) return;

        preferredPlatformIds = await DbContext.UserPlatformPreferences
            .Where(p => p.UserId == userId)
            .Select(p => p.PlatformId)
            .ToListAsync();
    }

    private void ParseFilterParams()
    {
        selectedGenreIds = ParseIds(GenresParam);
        // No "platforms" param at all means the user hasn't touched this filter yet, so default
        // to their saved preferred platforms. An explicit empty value ("platforms=") means they
        // deliberately cleared the filter and should see all platforms.
        selectedPlatformIds = PlatformsParam is null ? new List<int>(preferredPlatformIds) : ParseIds(PlatformsParam);
        minMetacritic = MetacriticParam;
    }

    private static List<int> ParseIds(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new();

        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();
    }

    private string BuildFilterSignature() =>
        $"{string.Join(",", selectedGenreIds.OrderBy(x => x))}|{string.Join(",", selectedPlatformIds.OrderBy(x => x))}|{minMetacritic}";

    private Func<int, Task<RawgPagedResult>> BuildPopularFetcher() =>
        page => RawgApi.GetPopularGamesAsync(page, genreIds: selectedGenreIds, platformIds: selectedPlatformIds, minMetacritic: minMetacritic);

    private Func<int, Task<RawgPagedResult>> BuildSearchFetcher() =>
        page => RawgApi.SearchGamesAsync(searchQuery, page, genreIds: selectedGenreIds, platformIds: selectedPlatformIds, minMetacritic: minMetacritic);

    private string GenreNames(IEnumerable<int> ids) =>
        string.Join(", ", allGenres.Where(g => ids.Contains(g.Id)).Select(g => g.Name));

    private string PlatformNames(IEnumerable<int> ids) =>
        string.Join(", ", allPlatforms.Where(p => ids.Contains(p.Id)).Select(p => p.Name));

    private Task ClearGenreFilter() => ApplyFilters((new List<int>(), selectedPlatformIds, minMetacritic));

    private Task ClearPlatformFilter() => ApplyFilters((selectedGenreIds, new List<int>(), minMetacritic));

    private Task ClearMetacriticFilter() => ApplyFilters((selectedGenreIds, selectedPlatformIds, null));

    private async Task ApplyFilters((List<int> GenreIds, List<int> PlatformIds, int? MinMetacritic) result)
    {
        var queryParams = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            queryParams.Add($"q={Uri.EscapeDataString(searchQuery)}");
        }

        if (result.GenreIds.Count > 0)
        {
            queryParams.Add($"genres={string.Join(",", result.GenreIds)}");
        }

        // Always include "platforms", even when empty, so an explicit "clear" is distinguishable
        // from "no filter chosen yet" (which falls back to the user's saved preferred platforms).
        queryParams.Add($"platforms={string.Join(",", result.PlatformIds)}");

        if (result.MinMetacritic is > 0)
        {
            queryParams.Add($"metacritic={result.MinMetacritic}");
        }

        var query = queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "";
        Nav.NavigateTo($"/{query}");
        await Task.CompletedTask;
    }

    private Func<int, Task<RawgPagedResult>> currentFetcher = null!;
    private string? cacheKey;

    private void RestoreFromCache()
    {
        games = Cache.Games;
        addedRawgIds = Cache.AddedRawgIds;
        hasMore = Cache.HasMore;
        currentPage = Cache.CurrentPage;
        hasSearched = Cache.HasSearched;
        isFallbackActive = Cache.IsFallbackActive;
        cacheKey = Cache.Query;
    }

    private void SaveToCache()
    {
        Cache.IsPopulated = true;
        Cache.Query = cacheKey;
        Cache.FilterSignature = BuildFilterSignature();
        Cache.Games = games;
        Cache.AddedRawgIds = addedRawgIds;
        Cache.HasMore = hasMore;
        Cache.CurrentPage = currentPage;
        Cache.HasSearched = hasSearched;
        Cache.IsFallbackActive = isFallbackActive;
    }

    private async Task LoadDefaultGames()
    {
        cacheKey = null;
        currentFetcher = BuildPopularFetcher();
        await FetchGames("Couldn't load games right now. Please try again.");
    }

    private async Task Search()
    {
        cacheKey = searchQuery;
        currentFetcher = BuildSearchFetcher();
        await FetchGames("Couldn't search games right now. Please try again.");
    }

    private async Task FetchGames(string errorMessage)
    {
        isSearching = true;
        searchFailed = false;
        hasSearched = true;
        currentPage = 1;

        try
        {
            var result = await currentFetcher(currentPage);
            games = result.Games;
            hasMore = result.HasMore;
            isFallbackActive = RawgApi.LastFetchWasFallback;
        }
        catch (Exception)
        {
            games = new();
            hasMore = false;
            searchFailed = true;
            lastErrorMessage = errorMessage;
            Toast.Show(errorMessage, ToastLevel.Error);
        }

        isSearching = false;
        SyncAddedRawgIds();

        if (!searchFailed)
        {
            SaveToCache();
        }
    }

    private async Task RetryLoad()
    {
        if (lastErrorMessage is null) return;
        await FetchGames(lastErrorMessage);
    }

    private async Task LoadMoreGames()
    {
        if (isLoadingMore || !hasMore) return;

        isLoadingMore = true;

        try
        {
            var result = await currentFetcher(currentPage + 1);
            games.AddRange(result.Games);
            hasMore = result.HasMore;
            currentPage++;
            isFallbackActive = RawgApi.LastFetchWasFallback;
            SyncAddedRawgIds();
            SaveToCache();
        }
        catch (Exception)
        {
            Toast.Show("Couldn't load more games right now. Please try again.", ToastLevel.Error);
        }

        isLoadingMore = false;
    }

    private void SyncAddedRawgIds()
    {
        if (searchFailed || userId == null || games.Count == 0) return;

        var rawgIds = games.Select(g => g.Id).ToList();
        addedRawgIds = DbContext.UserGames
            .Where(g => g.UserId == userId && rawgIds.Contains(g.RawgId))
            .Select(g => g.RawgId)
            .ToHashSet();
    }

    private async Task AddToShelf(RawgGameDto rawgGame, MouseEventArgs e)
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (currentUserId == null) return;

        var exists = DbContext.UserGames.Any(g => g.UserId == currentUserId && g.RawgId == rawgGame.Id);
        if (exists) return;

        var newUserGame = new UserGame
        {
            UserId = currentUserId,
            RawgId = rawgGame.Id,
            Title = rawgGame.Name,
            CoverArtUrl = rawgGame.Background_Image,
            Platform = rawgGame.Platforms.FirstOrDefault()?.Platform.Name ?? "Unknown",
            Status = PlayStatus.Backlog
        };

        try
        {
            DbContext.UserGames.Add(newUserGame);
            await DbContext.SaveChangesAsync();
            addedRawgIds.Add(rawgGame.Id);
            await JS.InvokeVoidAsync("questLogParticles.boom", e.ClientX, e.ClientY);
        }
        catch (Exception)
        {
            Toast.Show("Couldn't add that game to your shelf. Please try again.", ToastLevel.Error);
        }
    }
}
